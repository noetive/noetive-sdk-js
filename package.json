{
  "name": "@noetive/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript/JavaScript SDK for the Noetive platform: Semantik (semantic publish, search and subscribe) and Bud (managed mail for agents).",
  "license": "Apache-2.0",
  "author": {
    "name": "Noetive",
    "email": "support@noetive.io"
  },
  "homepage": "https://noetive.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/noetive/noetive-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/noetive/noetive-sdk-js/issues"
  },
  "keywords": [
    "noetive",
    "semantik",
    "bud",
    "agents",
    "semantic-search",
    "embeddings",
    "vector-search",
    "sse"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./semantik": {
      "import": {
        "types": "./dist/semantik/index.d.ts",
        "default": "./dist/semantik/index.js"
      },
      "require": {
        "types": "./dist/semantik/index.d.cts",
        "default": "./dist/semantik/index.cjs"
      }
    },
    "./bud": {
      "import": {
        "types": "./dist/bud/index.d.ts",
        "default": "./dist/bud/index.js"
      },
      "require": {
        "types": "./dist/bud/index.d.cts",
        "default": "./dist/bud/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test examples tools",
    "format": "biome format --write src test examples tools",
    "test": "vitest run test/unit",
    "test:watch": "vitest test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "test:all": "vitest run",
    "coverage": "vitest run test/unit --coverage",
    "recorder": "tsx tools/recorder.ts",
    "example": "tsx",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "fast-check": "^3.23.0",
    "msw": "^2.6.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
